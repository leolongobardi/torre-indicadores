{
  "name": "torre-indicadores",
  "main": "./worker.mjs",
  "compatibility_date": "2026-11-26",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/data", "/api/data/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "torre-indicadores",
    "database_id": "f904554c-d50c-46da-ad14-a17f8ae529b4",
    "migrations_dir": "./migrations"
  }]
}
